<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_PageBuilder:etc/content_type.xsd">
    <type name="mageos_faq"
          label="FAQ"
          menu_section="add_content"
          icon="icon-pagebuilder-block"
          component="Magento_PageBuilder/js/content-type"
          preview_component="Magento_PageBuilder/js/content-type/preview"
          master_component="Magento_PageBuilder/js/content-type/master"
          form="pagebuilder_mageos_faq_form"
          sortOrder="10"
          translate="label">
        <appearances>
            <appearance name="default"
                        default="true"
                        preview_template="MageOS_Faq/content-type/mageos_faq/default/preview"
                        master_template="MageOS_Faq/content-type/mageos_faq/default/master"
                        reader="Magento_PageBuilder/js/master-format/read/configurable">
                <elements>
                    <element name="main">
                        <style name="text_align" source="text_align"/>
                        <style name="margins" storage_key="margins_and_padding"
                        reader="Magento_PageBuilder/js/property/margins"
                        converter="Magento_PageBuilder/js/converter/style/margins"/>
                        <style name="padding" storage_key="margins_and_padding"
                        reader="Magento_PageBuilder/js/property/paddings"
                        converter="Magento_PageBuilder/js/converter/style/paddings"/>
                        <style name="display" source="display"
                        converter="Magento_PageBuilder/js/converter/style/display"
                        preview_converter="Magento_PageBuilder/js/converter/style/preview/display"/>

                        <attribute name="name" source="data-content-type"/>
                        <attribute name="appearance" source="data-appearance"/>
                        <!--
                            The {{widget}} directive the storefront renders; on the stage, the group
                            identifier instead (preview converter).
                        -->
                        <html name="html"
                              preview_converter="MageOS_Faq/js/content-type/mageos_faq/converter/preview/group"/>
                        <css name="css_classes"/>
                    </element>
                </elements>
                <converters>
                    <!-- As core's Block and Products content types: the settings live in the directive. -->
                    <converter component="MageOS_Faq/js/content-type/mageos_faq/mass-converter/widget-directive"
                               name="widget_directive">
                        <config>
                            <item name="html_variable" value="html"/>
                        </config>
                    </converter>
                </converters>
            </appearance>
        </appearances>
    </type>
</config>
