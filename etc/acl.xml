<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!--
                    Where its menu item is, Marketing → SEO, beside MageOS_Seo's Organization
                    Settings.
                -->
                <resource id="Magento_Backend::marketing">
                    <resource id="MageOS_Seo::seo">
                        <resource id="MageOS_Faq::faq" title="FAQ Manager" translate="title" sortOrder="15"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
